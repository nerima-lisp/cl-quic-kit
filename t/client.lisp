        (let ((delayed-old (let ((late (funcall make-test-client
                                                (test-octets
                                                 '(1 2 3 4 5 6 7 8)))))
                             (cl-quic-kit::%client-set-key late :1-rtt :write old-key)
                             (setf (cl-quic-kit::quic-client-application-write-secret late)
