                       (cl-quic-kit:packet-header-payload decoded)
                       (subseq plain 0 (+ offset pn-length))))))))
        (unwind-protect (funcall function client #'packet #'frames (lambda () (reverse writes)))
          (cl-quic-kit:client-close client)
          (check (cl-quic-kit::quic-client-closed-p client) "fixture cleanup closes the client")
          (check (null (cl-quic-kit::quic-client-udp-socket client)) "fixture owns no UDP socket"))))))


(defun auth-drop-damaged-packet (packet number)
  (let ((bytes (funcall packet number)))
    (setf (aref bytes (1- (length bytes)))
          (logxor 1 (aref bytes (1- (length bytes)))))
    bytes))

(defun auth-drop-check-ack (frames number)
  (let ((ack (find :ack frames :key #'cl-quic-kit:frame-type)))
    (check ack "authenticated control produces an ACK")
    (check (= number (cl-quic-kit:frame-field ack :largest-acknowledged))
           "only authenticated packet numbers are acknowledged")
    (check (equal (list (cons number 0)) (cl-quic-kit:frame-field ack :ranges))
           "discarded packets do not enter ACK ranges")
    (check (not (find :connection-close frames :key #'cl-quic-kit:frame-type))
           "drop does not emit CONNECTION_CLOSE")))

(defun auth-drop-prefix-and-sample ()
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (dolist (bytes (list (auth-drop-octets 255) (auth-drop-octets 192)
                         (auth-drop-octets 0) (auth-drop-bare-packet)))
       (check (null (cl-quic-kit:client-receive-datagram client bytes))
              "unauthenticated truncated input is discarded")
       (check (not (cl-quic-kit::quic-client-closed-p client)) "drop stays open")
       (check (null (funcall writes)) "drop performs no writes")
       (check (zerop (cl-quic-kit::quic-client-authentication-failures client))
              "header truncation is not an AEAD failure"))
     (check (cl-quic-kit:client-receive-datagram client (funcall packet 4))
            "authenticated control after truncated input is accepted")
     (cl-quic-kit:client-poll client)
     (auth-drop-check-ack (funcall frames) 4))))

(defun auth-drop-aead-lifetime ()
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (loop for number below 2 do
       (check (null (cl-quic-kit:client-receive-datagram
                     client (auth-drop-damaged-packet packet number)))
              "invalid tag is discarded")
       (check (= (1+ number) (cl-quic-kit::quic-client-authentication-failures client))
              "authentication failures accumulate")
       (check (not (cl-quic-kit::quic-client-closed-p client)) "invalid tag stays open")
       (check (null (funcall writes)) "invalid tag performs no writes"))
     (check (cl-quic-kit:client-receive-datagram client (funcall packet 2))
            "valid authentication remains usable after failures")
     (check (= 2 (cl-quic-kit::quic-client-authentication-failures client))
            "successful authentication does not reset the lifetime counter")
     (cl-quic-kit:client-poll client)
     (auth-drop-check-ack (funcall frames) 2))))

(defun auth-drop-coalesced ()
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (declare (ignore writes))
     (let ((header (cl-quic-kit:client-receive-datagram
                    client (concatenate '(vector (unsigned-byte 8))
                                        (auth-drop-damaged-packet packet 0)
                                        (funcall packet 1)))))
       (check (and header (= 1 (cl-quic-kit:packet-header-packet-number header)))
              "a later authenticated coalesced packet is processed"))
     (check (= 1 (cl-quic-kit::quic-client-authentication-failures client))
            "coalesced failure counted once")
     (check (not (cl-quic-kit::quic-client-closed-p client)) "coalesced drop stays open")
     (cl-quic-kit:client-poll client)
     (auth-drop-check-ack (funcall frames) 1)))
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (declare (ignore writes))
     (let ((header (cl-quic-kit:client-receive-datagram
                    client (concatenate '(vector (unsigned-byte 8))
                                        (funcall packet 2) (auth-drop-octets 255)))))
       (check (and header (= 2 (cl-quic-kit:packet-header-packet-number header)))
              "truncated tail preserves the authenticated preceding packet"))
     (check (not (cl-quic-kit::quic-client-closed-p client)) "truncated tail stays open")
     (cl-quic-kit:client-poll client)
     (auth-drop-check-ack (funcall frames) 2))))

(defun auth-drop-authenticated-violation ()
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (check (null (cl-quic-kit:client-receive-datagram
                   client (funcall packet 0 (auth-drop-octets 31 0 0 0 0 0 0 0))))
            "authenticated unknown frame is rejected")
     (check (cl-quic-kit::quic-client-closed-p client)
            "authenticated protocol violation closes")
     (check (zerop (cl-quic-kit::quic-client-authentication-failures client))
            "authenticated protocol error is not an authentication failure")
     (let ((close (find :connection-close (funcall frames) :key #'cl-quic-kit:frame-type)))
       (check close "authenticated protocol error emits CONNECTION_CLOSE")
       (check (= 7 (cl-quic-kit:frame-field close :error-code)) "protocol close code preserved"))
     (let ((before (length (funcall writes))))
       (check (null (cl-quic-kit:client-receive-datagram client (funcall packet 1)))
              "closed client rejects subsequent input")
       (check (= before (length (funcall writes))) "closed input produces no extra writes")))))

(defun auth-drop-provider-error (condition)
  (auth-drop-fixture
   (lambda (client packet frames writes)
     (declare (ignore writes))
     (let ((wire (funcall packet 0))
           (observed nil)
           (original cl-quic-kit.protection::*aead-open*))
       (let ((cl-quic-kit.protection::*aead-open*
               (lambda (&rest arguments)
                 (declare (ignore arguments))
                 (handler-bind ((error (lambda (value) (setf observed value))))
                   (error condition)))))
         (check (null (cl-quic-kit:client-receive-datagram client wire))
                "provider operational error is not accepted"))
       (check (eq condition observed) "original operational condition identity is preserved")
       (check (eq original cl-quic-kit.protection::*aead-open*) "provider callback is restored")
       (check (cl-quic-kit::quic-client-closed-p client) "provider operational error closes")
       (check (zerop (cl-quic-kit::quic-client-authentication-failures client))
              "operational error does not increment authentication failures")
       (let ((close (find :connection-close (funcall frames) :key #'cl-quic-kit:frame-type)))
         (check close "operational error emits an actual wire close")
         (check (= 7 (cl-quic-kit:frame-field close :error-code)) "operational close code preserved")
         (check (equalp (map '(vector (unsigned-byte 8)) #'char-code "QUIC receive failure")
                        (cl-quic-kit:frame-field close :reason))
                "wire close uses a fixed reason without provider diagnostics")
         (check (not (search (map '(vector (unsigned-byte 8)) #'char-code
                                 "provider-diagnostic-canary")
                             (cl-quic-kit:frame-field close :reason)))
                "decoded wire close excludes the provider diagnostic canary"))))))

