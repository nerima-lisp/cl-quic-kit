(require :sb-posix)

(defun client-close-fd-open-p (descriptor)
  (handler-case (progn (sb-posix:fcntl descriptor sb-posix:f-getfd) t)
    (sb-posix:syscall-error (condition)
      (if (= (sb-posix:syscall-errno condition) sb-posix:ebadf)
          nil
          (error condition)))))

(defun client-close-wire-frames (wire destination)
  (let* ((key (getf (cl-quic-kit.protection:derive-initial-secrets destination) :client))
         (header (cl-quic-kit:decode-packet-header wire))
         (offset (- (length wire) (cl-quic-kit:packet-header-payload-length header)))
         (sample (subseq wire (+ offset 4) (+ offset 20)))
         (first (cl-quic-kit.protection:remove-header-protection key wire sample offset 4 t))
         (pn-length (1+ (logand (aref first 0) 3)))
         (plain (cl-quic-kit.protection:remove-header-protection key wire sample offset pn-length t))
         (decoded (cl-quic-kit:decode-packet-header plain)))
    (check (eq :initial (cl-quic-kit:packet-header-type decoded)) "close uses Initial protection")
    (check (equalp destination (cl-quic-kit:packet-header-destination-connection-id decoded))
           "close addresses the configured peer")
    (cl-quic-kit:decode-frames
     (cl-quic-kit.protection:unprotect-payload
      key (cl-quic-kit:packet-header-packet-number decoded)
      (cl-quic-kit:packet-header-payload decoded) (subseq plain 0 (+ offset pn-length))))))

(defun client-close-socket-case (provided-p send-failure-p cleanup-failure-p)
  (let ((cl-quic-kit.protection::*hkdf-extract* #'crypto-kit:hkdf-extract)
        (cl-quic-kit.protection::*hkdf-expand* #'crypto-kit:hkdf-expand)
        (cl-quic-kit.protection::*aead-seal* #'crypto-kit:aead-seal)
        (cl-quic-kit.protection::*aead-open* #'crypto-kit:aead-open)
        (cl-quic-kit.protection::*aes-ecb* #'crypto-kit:aes-encrypt-block)
        (cl-quic-kit.protection::*chacha20* #'crypto-kit:chacha20-keystream)
        (cl-quic-kit.protection::*constant-time-equal* #'crypto-kit:constant-time-equal))
    (let* ((listener (cl-quic-kit:make-udp-socket :local-host "127.0.0.1" :non-blocking-p nil))
           (provided nil) (client nil) (socket nil) (native nil) (descriptor nil)
           (destination (auth-drop-octets 8 7 6 5 4 3 2 1))
           (send-condition (make-condition 'simple-error :format-control "close send failure"))
           (cleanup-condition (make-condition 'simple-error :format-control "close cleanup failure"))
           (writes nil) (native-closes 0)
           (original-close (symbol-function 'sb-bsd-sockets:socket-close)))
      (unwind-protect
           (progn
             (when provided-p
               (setf provided (cl-quic-kit:make-udp-socket
                               :remote-host "127.0.0.1"
                               :remote-port (cl-quic-kit:udp-socket-local-port listener))))
             (setf client
                   (cl-quic-kit:make-quic-client
                    :hostname "localhost" :udp-socket provided
                    :server-host "127.0.0.1" :server-port (cl-quic-kit:udp-socket-local-port listener)
                    :local-connection-id (auth-drop-octets 1 2 3 4 5 6 7 8)
                    :destination-connection-id destination
                    :io-write (lambda (connection bytes)
                                (check (eq connection (cl-quic-kit::quic-client-connection client))
                                       "close callback receives the client's connection")
                                (push bytes writes)
                                (when send-failure-p (error send-condition)))))
             (setf socket (cl-quic-kit::quic-client-udp-socket client)
                   native (cl-quic-kit::udp-socket-socket socket)
                   descriptor (sb-bsd-sockets:socket-file-descriptor native))
             (check (if provided-p (eq socket provided) (not (eq socket provided)))
                    "client socket ownership matches the public constructor input")
             (check (client-close-fd-open-p descriptor) "client owns an open descriptor before close")
             (check (= 3 (cl-quic-kit:udp-send socket (auth-drop-octets 7 8 9)))
                    "the real socket can send before close")
             (multiple-value-bind (bytes length peer) (cl-quic-kit:udp-receive listener :wait-p t)
               (check (equalp bytes #(7 8 9)) "loopback receives the actual socket's bytes")
               (check (= length 3) "loopback reports the actual datagram length")
               (check (equalp peer #(127 0 0 1)) "loopback receives from localhost")
               (check (plusp (cl-quic-kit:udp-socket-local-port socket))
                      "the client socket has a real bound port"))
             (setf (symbol-function 'sb-bsd-sockets:socket-close)
                   (lambda (raw &rest arguments)
                     (if (eq raw native)
                         (progn
                           (incf native-closes)
                           (apply original-close raw arguments)
                           (when cleanup-failure-p (error cleanup-condition)))
                         (apply original-close raw arguments))))
             (let ((caught nil) (result nil))
               (handler-case (setf result (cl-quic-kit:client-close client :error-code 7 :reason "close"))
                 (error (condition) (setf caught condition)))
               (check (eq caught (cond (send-failure-p send-condition)
                                      (cleanup-failure-p cleanup-condition)))
                      "original send error takes precedence; cleanup-only failure propagates")
               (check (eq result (not (or send-failure-p cleanup-failure-p)))
                      "only a successful close returns T"))
             (check (not (client-close-fd-open-p descriptor)) "first close releases the actual descriptor")
             (check (= native-closes 1) "first close invokes native cleanup exactly once")
             (check (cl-quic-kit::udp-socket-closed-p socket) "UDP ownership is closed")
             (check (cl-quic-kit:quic-client-closed-p client) "client is closed after every outcome")
             (check (eq :closing (cl-quic-kit:connection-state (cl-quic-kit::quic-client-connection client)))
                    "the connection enters closing")
             (check (= 1 (length writes)) "close attempts one protected datagram")
             (let* ((frames (client-close-wire-frames (first writes) destination))
                    (close (find :connection-close frames :key #'cl-quic-kit:frame-type)))
               (check (= 1 (count :connection-close frames :key #'cl-quic-kit:frame-type))
                      "wire contains exactly one transport close")
               (check (= 7 (cl-quic-kit:frame-field close :error-code)) "wire retains the requested error code")
               (check (= 0 (cl-quic-kit:frame-field close :frame-type)) "wire close has no triggering frame")
               (check (equalp #(99 108 111 115 101) (cl-quic-kit:frame-field close :reason))
                      "wire retains the close reason"))
             (check (cl-quic-kit:client-close client) "repeated close succeeds without retrying errors")
             (check (= native-closes 1) "repeated close does not repeat native cleanup")
             (check (= 1 (length writes)) "repeated close does not repeat the send")
             (check (not (client-close-fd-open-p descriptor)) "repeated close keeps the descriptor closed"))
        (setf (symbol-function 'sb-bsd-sockets:socket-close) original-close)
        (when (and native descriptor (client-close-fd-open-p descriptor))
          (funcall original-close native))
        (when (and provided (not socket)) (cl-quic-kit:udp-close provided))
        (cl-quic-kit:udp-close listener))
      (check (eq original-close (symbol-function 'sb-bsd-sockets:socket-close))
             "native socket-close spy is restored exactly"))))

(defun client-close-provided-control () (client-close-socket-case t nil nil))
(defun client-close-internal-control () (client-close-socket-case nil nil nil))
(defun client-close-provided-send-error () (client-close-socket-case t t nil))
(defun client-close-internal-send-error () (client-close-socket-case nil t nil))
(defun client-close-cleanup-error () (client-close-socket-case t nil t))
(defun client-close-dual-error () (client-close-socket-case t t t))

(client-close-provided-control)
(client-close-internal-control)
(client-close-provided-send-error)
(client-close-internal-send-error)
(client-close-cleanup-error)
(client-close-dual-error)


(defun auth-drop-security-fixture (type cipher function)
  (auth-drop-fixture
   (lambda (client initial-packet initial-frames writes)
     (declare (ignore initial-frames))
     (let* ((secret (make-array 32 :element-type '(unsigned-byte 8) :initial-element 19))
            (application-key (cl-quic-kit.protection:make-key-set secret :cipher cipher))
            (initial-keys (cl-quic-kit.protection:derive-initial-secrets
                           (auth-drop-octets 8 7 6 5 4 3 2 1))))
       (when (eq type :short)
         (dolist (direction '(:read :write))
           (cl-quic-kit::%client-set-key client :1-rtt direction application-key))
         (setf (cl-quic-kit::quic-client-application-read-secret client) secret
               (cl-quic-kit::quic-client-application-write-secret client) secret))
       (labels ((packet (number reserved)
                  (let* ((payload (auth-drop-octets 1 0 0 0 0 0 0 0))
                         (key (if (eq type :short) application-key (getf initial-keys :server)))
                         (long-p (not (eq type :short)))
                         (wire (cl-quic-kit:encode-packet-header
                                (cl-quic-kit:make-packet-header
                                 :type type :version 1
                                 :destination-connection-id (auth-drop-octets 1 2 3 4 5 6 7 8)
                                 :source-connection-id (auth-drop-octets 8 7 6 5 4 3 2 1)
                                 :packet-number number :packet-number-length 4
                                 :payload (make-array 24 :element-type '(unsigned-byte 8)))))
                         (offset (- (length wire) 28))
                         (position (if long-p 2 3)))
                    ;; Set the RFC 9000 wire bits before AEAD authenticates the header.
                    (setf (ldb (byte 2 position) (aref wire 0)) reserved)
                    (let* ((associated (subseq wire 0 (+ offset 4)))
                           (sealed (cl-quic-kit.protection:protect-payload key number payload associated)))
                      (check (equalp payload (cl-quic-kit.protection:unprotect-payload
                                              key number sealed associated))
                             "reserved-bit fixture has a genuinely authenticated payload")
                      (replace wire sealed :start1 (+ offset 4))
                      (let* ((sample (subseq wire (+ offset 4) (+ offset 20)))
                             (protected (cl-quic-kit.protection:apply-header-protection
                                         key wire sample offset 4 long-p))
                             (unmasked (cl-quic-kit.protection:remove-header-protection
                                        key protected sample offset 4 long-p)))
                        (check (= reserved (ldb (byte 2 position) (aref unmasked 0)))
                               "header protection roundtrip preserves the RFC reserved bits")
                        protected))))
                (frames ()
                  (loop for wire in (funcall writes) append
                    (let* ((long-p (logbitp 7 (aref wire 0)))
                           (key (if long-p (getf initial-keys :client) application-key))
                           (offset (if long-p
                                       (- (length wire)
                                          (cl-quic-kit:packet-header-payload-length
                                           (cl-quic-kit:decode-packet-header wire)))
                                       9))
                           (sample (subseq wire (+ offset 4) (+ offset 20)))
                           (first (cl-quic-kit.protection:remove-header-protection
                                   key wire sample offset 4 long-p))
                           (pn-length (1+ (logand (aref first 0) 3)))
                           (plain (cl-quic-kit.protection:remove-header-protection
                                   key wire sample offset pn-length long-p))
                           (number (reduce (lambda (value byte) (+ (ash value 8) byte))
                                           plain :start offset :end (+ offset pn-length)
                                           :initial-value 0)))
                      (cl-quic-kit:decode-frames
                       (cl-quic-kit.protection:unprotect-payload
                        key number (subseq plain (+ offset pn-length))
                        (subseq plain 0 (+ offset pn-length))))))))
         (funcall function client #'packet #'frames writes initial-packet))))))

(defun auth-drop-security-close (client frames writes code)
  (check (cl-quic-kit:quic-client-closed-p client) "authenticated violation closes the client")
  (check (eq :closing (cl-quic-kit:connection-state (cl-quic-kit::quic-client-connection client)))
         "authenticated violation enters closing")
  (check (= 1 (length (funcall writes))) "violation emits exactly one protected datagram")
  (let* ((decoded (funcall frames))
         (close (find :connection-close decoded :key #'cl-quic-kit:frame-type)))
    (check (= 1 (count :connection-close decoded :key #'cl-quic-kit:frame-type))
           "wire contains exactly one transport close")
    (check (= code (cl-quic-kit:frame-field close :error-code)) "wire carries the specified error")
    (check (= 0 (cl-quic-kit:frame-field close :frame-type)) "header violation has no triggering frame")
    (check (not (find :ack decoded :key #'cl-quic-kit:frame-type)) "rejected packet is not acknowledged")))

(defun auth-drop-reserved-case (type reserved bad-tag-p)
  (auth-drop-security-fixture
   type :aes-128-gcm
   (lambda (client packet frames writes initial-packet)
     (declare (ignore initial-packet))
     (let ((wire (funcall packet 0 reserved)))
       (when bad-tag-p
         (setf (aref wire (1- (length wire))) (logxor 1 (aref wire (1- (length wire))))))
       (let ((result (cl-quic-kit:client-receive-datagram client wire :short-header-dcid-length 8)))
         (cond
           (bad-tag-p
            (check (null result) "bad tag with reserved bits is discarded")
            (check (not (cl-quic-kit:quic-client-closed-p client)) "reserved bits are not checked before AEAD")
            (check (= 1 (cl-quic-kit::quic-client-authentication-failures client)) "bad tag counts once")
            (check (null (cl-quic-kit::quic-client-received-packets client)) "bad tag leaves receive history unchanged")
            (check (null (funcall writes)) "bad tag sends neither ACK nor close")
            (check (cl-quic-kit:client-receive-datagram client (funcall packet 1 0)
                                                     :short-header-dcid-length 8)
                   "normal authenticated control still succeeds after the drop")
            (cl-quic-kit:client-poll
             client (+ (funcall (cl-quic-kit::quic-client-clock client))
                       cl-quic-kit.recovery::+max-ack-delay+))
            (auth-drop-check-ack (funcall frames) 1))
           ((zerop reserved)
            (check result "zero reserved bits are accepted")
            (check (zerop (cl-quic-kit:packet-header-reserved-bits result)) "normal result reports zero reserved bits")
            (check (not (cl-quic-kit:quic-client-closed-p client)) "normal authenticated packet stays open")
            (check (zerop (cl-quic-kit::quic-client-authentication-failures client)) "normal control is not an AEAD failure")
            (cl-quic-kit:client-poll
             client (+ (funcall (cl-quic-kit::quic-client-clock client))
                       cl-quic-kit.recovery::+max-ack-delay+))
            (auth-drop-check-ack (funcall frames) 0))
           (t
            (check (null result) "authenticated nonzero reserved bits are rejected")
            (auth-drop-security-close client frames writes #xa)
            (check (zerop (cl-quic-kit::quic-client-authentication-failures client))
                   "authenticated reserved bits do not count as an AEAD failure")
            (check (null (cl-quic-kit::quic-client-received-packets client))
                   "authenticated reserved bits never enter receive history")
            (check (null (cl-quic-kit:client-receive-datagram client (funcall packet 1 0)
                                                           :short-header-dcid-length 8))
                   "closed client rejects subsequent valid packets")
            (check (= 1 (length (funcall writes))) "closed client does not send again"))))))))

(defun auth-drop-reserved-long ()
  (auth-drop-reserved-case :initial 0 nil)
  (loop for reserved from 1 to 3 do (auth-drop-reserved-case :initial reserved t))
  (loop for reserved from 1 to 3 do (auth-drop-reserved-case :initial reserved nil)))

(defun auth-drop-reserved-short ()
  (auth-drop-reserved-case :short 0 nil)
  (loop for reserved from 1 to 3 do (auth-drop-reserved-case :short reserved t))
  (loop for reserved from 1 to 3 do (auth-drop-reserved-case :short reserved nil)))

(defun auth-drop-integrity-boundary ()
  (dolist (cipher '(:aes-128-gcm :aes-256-gcm :chacha20-poly1305))
    (auth-drop-security-fixture
     :short cipher
     (lambda (client packet frames writes initial-packet)
       (let ((limit (if (eq cipher :chacha20-poly1305) (expt 2 36) (expt 2 52))))
         ;; Seed the real lifetime counter; leave the production cipher limit intact.
         (setf (cl-quic-kit::quic-client-authentication-failures client) (- limit 2))
         (check (null (cl-quic-kit:client-receive-datagram
                       client (auth-drop-damaged-packet initial-packet 0)))
                "Initial-key authentication failure is discarded")
         (check (= (1- limit) (cl-quic-kit::quic-client-authentication-failures client))
                "Initial-key failure contributes to the lifetime count")
         (check (not (cl-quic-kit:quic-client-closed-p client)) "below-limit failure stays open")
         (check (null (funcall writes)) "below-limit failure performs no writes")
         (check (cl-quic-kit:client-receive-datagram client (funcall initial-packet 1))
                "Initial-key authenticated control succeeds")
         (check (= (1- limit) (cl-quic-kit::quic-client-authentication-failures client))
                "successful Initial authentication does not reset lifetime failures")
         (check (null (cl-quic-kit:client-receive-datagram
                       client (auth-drop-damaged-packet (lambda (number) (funcall packet number 0)) 0)
                       :short-header-dcid-length 8))
                "application-key failure at the cipher limit is discarded")
         (check (= limit (cl-quic-kit::quic-client-authentication-failures client))
                "all-key lifetime aggregation reaches the exact cipher limit")
         (check (not (cl-quic-kit:quic-client-closed-p client)) "the allowed integrity limit remains open")
         (check (null (funcall writes)) "at-limit drop sends no close or ACK")
         (check (cl-quic-kit:client-receive-datagram client (funcall packet 1 0)
                                                  :short-header-dcid-length 8)
                "application-key authenticated control succeeds at the limit")
         (check (= limit (cl-quic-kit::quic-client-authentication-failures client))
                "successful application authentication does not reset lifetime failures")
         (check (null (cl-quic-kit:client-receive-datagram
                       client (auth-drop-damaged-packet (lambda (number) (funcall packet number 0)) 2)
                       :short-header-dcid-length 8))
                "the next authentication failure is rejected")
         (check (= (1+ limit) (cl-quic-kit::quic-client-authentication-failures client))
                "only exceeding the actual cipher limit closes")
         ;; Valid controls have pending ACKs; the rejected packet must not enter them.
         (check (equal '((:1-rtt 1) (:initial 1))
                       (cl-quic-kit::quic-client-received-packets client))
                "receive history contains only the two authenticated controls")
         (check (cl-quic-kit:quic-client-closed-p client) "beyond-limit failure closes the client")
         (check (eq :closing (cl-quic-kit:connection-state (cl-quic-kit::quic-client-connection client)))
                "beyond-limit failure enters closing")
         (let* ((decoded (funcall frames))
                (close (find :connection-close decoded :key #'cl-quic-kit:frame-type)))
           (check (= 1 (count :connection-close decoded :key #'cl-quic-kit:frame-type))
                  "wire contains exactly one integrity-limit close")
           (check (= #xf (cl-quic-kit:frame-field close :error-code)) "wire carries AEAD_LIMIT_REACHED")
           (check (= 0 (cl-quic-kit:frame-field close :frame-type)) "integrity close has no triggering frame")
           (dolist (ack (remove-if-not (lambda (frame) (eq :ack (cl-quic-kit:frame-type frame))) decoded))
             (check (= 1 (cl-quic-kit:frame-field ack :largest-acknowledged))
                    "pending ACKs acknowledge only authenticated controls")))
         (let ((before (length (funcall writes))))
           (check (plusp before) "beyond-limit failure emits a protected close")
           (check (null (cl-quic-kit:client-receive-datagram client (funcall packet 3 0)
                                                          :short-header-dcid-length 8))
                  "closed client rejects subsequent valid input")
           (check (= before (length (funcall writes))) "closed client performs no further writes")
           (check (= (1+ limit) (cl-quic-kit::quic-client-authentication-failures client))
                  "closed client does not increment the lifetime count again")))))))

(auth-drop-reserved-long)
(auth-drop-reserved-short)
(auth-drop-integrity-boundary)


