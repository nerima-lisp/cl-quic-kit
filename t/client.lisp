(in-package #:cl-user)

(defun test-client-receive-credit ()
  (labels ((octets (&rest values)
             (make-array (length values) :element-type '(unsigned-byte 8)
                         :initial-contents values))
           (fixture ()
             (let* ((writes nil)
                    (client (cl-quic-kit:make-quic-client
                             :connection
                             (cl-quic-kit:make-quic-connection
                              :io-write (lambda (ignored bytes)
                                          (declare (ignore ignored))
                                          (push bytes writes)))
                             :local-connection-id (octets 0 0 0 0 0 0 0 0)
                             :destination-connection-id (octets 0 0 0 0 0 0 0 0)
                             :disable-hostname-verification-p t)))
               (values client
                       (lambda ()
                         (cl-quic-kit:client-flush client)
                         (prog1 (mapcar #'cl-quic-kit:decode-frame (reverse writes))
                           (setf writes nil))))))
           (maximums (frames type)
             (loop for frame in frames
                   when (eq (cl-quic-kit:frame-type frame) type)
                     collect (cl-quic-kit:frame-field frame :maximum))))
    (multiple-value-bind (client flush) (fixture)
      (let* ((first (cl-quic-kit:client-open-stream client nil))
             (second (cl-quic-kit:client-open-stream client nil))
             (flow (cl-quic-kit::quic-client-flow-control client))
             (initial (cl-quic-kit:flow-control-connection-receive-limit flow)))
        (cl-quic-kit:stream-receive-data first 0 (octets 1 2 3))
        (cl-quic-kit:stream-receive-data second 0 (octets 4 5))
        (check (equalp (cl-quic-kit:client-read-stream client first) (octets 1 2 3))
               "receive-credit connection: first stream delivers original bytes")
        (check (equalp (cl-quic-kit:client-read-stream client second) (octets 4 5))
               "receive-credit connection: second stream delivers original bytes")
        (check (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                  (+ initial 5))
               "receive-credit connection: consumption is summed across streams")
        (check (equal (maximums (funcall flush) :max-data)
                      (list (+ initial 3) (+ initial 5)))
               "receive-credit connection: each increment reaches the peer as MAX_DATA")))
    (multiple-value-bind (client flush) (fixture)
      (let ((stream (cl-quic-kit:client-open-stream client nil)))
        (cl-quic-kit:stream-set-max-receive-offset stream 131072)
        (cl-quic-kit:stream-receive-data stream 0 (octets 7 8 9))
        (cl-quic-kit:client-read-stream client stream)
        (let* ((frames (funcall flush))
               (frame (find :max-stream-data frames :key #'cl-quic-kit:frame-type)))
          (check (= (cl-quic-kit::stream-receive-max-offset stream) 131075)
                 "receive-credit stream: consumption preserves the configured window")
          (check (and frame
                      (= (cl-quic-kit:frame-field frame :stream-id)
                         (cl-quic-kit:stream-id stream))
                      (= (cl-quic-kit:frame-field frame :maximum) 131075))
                 "receive-credit stream: MAX_STREAM_DATA advertises the actual limit"))))
    (multiple-value-bind (client flush) (fixture)
      (let* ((stream (cl-quic-kit:client-open-stream client nil))
             (initial (cl-quic-kit:flow-control-connection-receive-limit
                       (cl-quic-kit::quic-client-flow-control client))))
        (cl-quic-kit:stream-receive-data stream 0 (octets 10 11) :fin t)
        (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
          (check (and fin (equalp data (octets 10 11)))
                 "receive-credit FIN: final bytes and FIN are preserved"))
        (check (equal (maximums (funcall flush) :max-data) (list (+ initial 2)))
               "receive-credit FIN: final bytes replenish connection credit")
        (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
          (check (and fin (equalp data (octets)))
                 "receive-credit FIN: a repeated final read is empty"))
        (check (null (funcall flush))
               "receive-credit FIN: repeated final reads do not advertise new credit")))
    (multiple-value-bind (client flush) (fixture)
      (let* ((stream (cl-quic-kit:client-open-stream client nil))
             (flow (cl-quic-kit::quic-client-flow-control client))
             (connection-limit (cl-quic-kit:flow-control-connection-receive-limit flow))
             (stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
        (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
          (check (and (equalp data (octets)) (not fin))
                 "receive-credit empty: no data or FIN is fabricated"))
        (check (and (= connection-limit
                       (cl-quic-kit:flow-control-connection-receive-limit flow))
                    (= stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
               "receive-credit empty: receive limits remain unchanged")
        (check (null (funcall flush))
               "receive-credit empty: no MAX_DATA or MAX_STREAM_DATA is emitted")))
    (multiple-value-bind (client flush) (fixture)
      (let* ((stream (cl-quic-kit:client-open-stream client nil))
             (flow (cl-quic-kit::quic-client-flow-control client))
             (maximum (1- (expt 2 62))))
        (cl-quic-kit:stream-set-max-receive-offset stream (1- maximum))
        (cl-quic-kit:flow-control-update-max-receive-data flow (1- maximum))
        (cl-quic-kit:stream-receive-data stream 0 (octets 12 13))
        (check (equalp (cl-quic-kit:client-read-stream client stream) (octets 12 13))
               "receive-credit saturation: data is delivered at the varint boundary")
        (check (and (= (cl-quic-kit::stream-receive-max-offset stream) maximum)
                    (= (cl-quic-kit:flow-control-connection-receive-limit flow) maximum))
               "receive-credit saturation: both limits stop at 2^62-1")
        (let ((frames (funcall flush)))
          (check (and (equal (maximums frames :max-data) (list maximum))
                      (equal (maximums frames :max-stream-data) (list maximum)))
                 "receive-credit saturation: encoded credit never exceeds a QUIC varint"))
        (cl-quic-kit:stream-receive-data stream 2 (octets 14 15 16))
        (check (equalp (cl-quic-kit:client-read-stream client stream) (octets 14 15 16))
               "receive-credit saturation: later data remains readable")
        (check (null (funcall flush))
               "receive-credit saturation: a saturated limit is not redundantly advertised")))))

(test-client-receive-credit)

(defun receive-credit-octets (&rest bytes)
  (make-array (length bytes) :element-type '(unsigned-byte 8)
                            :initial-contents bytes))

(defun receive-credit-fixture ()
  (let* ((writes nil)
         (client (cl-quic-kit:make-quic-client
                  :connection
                  (cl-quic-kit:make-quic-connection
                   :io-write (lambda (ignored bytes)
                               (declare (ignore ignored))
                               (push bytes writes)))
                  :local-connection-id (receive-credit-octets 0 0 0 0 0 0 0 0)
                  :destination-connection-id (receive-credit-octets 0 0 0 0 0 0 0 0)
                  :disable-hostname-verification-p t)))
    (values client
            (lambda (&key raw-p)
              (cl-quic-kit:client-flush client)
              (prog1 (if raw-p
                         (reverse writes)
                         (mapcar #'cl-quic-kit:decode-frame (reverse writes)))
                (setf writes nil))))))

(defun receive-credit-reset (client stream final-size number)
  (cl-quic-kit::%client-receive-frames
   client :1-rtt number
   (list (cl-quic-kit:make-frame
          :reset-stream :stream-id (cl-quic-kit:stream-id stream)
          :application-protocol-error-code 0 :final-size final-size))))

(defun test-client-reset-receive-credit ()
  (multiple-value-bind (client flush) (receive-credit-fixture)
    (let* ((flow (cl-quic-kit::quic-client-flow-control client))
           (initial (cl-quic-kit:flow-control-connection-receive-limit flow))
           (streams (loop repeat 16 collect
                      (cl-quic-kit:client-open-stream client nil))))
      (check (= initial (* 16 65536)) "reset fixture has the normal 1MiB window")
      (loop for stream in streams for number from 0 do
        (receive-credit-reset client stream 65536 number)
        (check (and (cl-quic-kit::stream-receive-reset-p stream)
                    (= (cl-quic-kit::stream-receive-highest-offset stream) 65536))
               "reset final size remains charged to received data"))
      (check (= (cl-quic-kit:flow-control-connection-received flow) initial)
             "reset final sizes remain cumulatively accounted")
      (check (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                (* 2 initial))
             "reset discarded final sizes replenish the connection window")
      (let ((frames (funcall flush)))
        (check (equal (mapcar (lambda (frame)
                               (cl-quic-kit:frame-field frame :maximum)) frames)
                      (loop for n from 1 to 16 collect (+ initial (* n 65536))))
               "each reset advertises exactly its connection credit")
        (check (every (lambda (frame)
                        (eq (cl-quic-kit:frame-type frame) :max-data)) frames)
               "reset does not grant credit to the dead stream"))
      (loop for stream in streams for number from 16 do
        (receive-credit-reset client stream 65536 number)
        (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 99))
        (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
          (check (and fin (zerop (length data)))
                 "reset duplicate and late data leave the discarded buffer empty")))
      (check (= (cl-quic-kit:flow-control-connection-received flow) initial)
             "duplicate resets and late STREAM data do not charge twice")
      (check (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                (* 2 initial))
             "duplicate resets and empty reads do not replenish twice")
      (check (null (funcall flush)) "duplicate resets do not advertise credit")
      (let ((next (cl-quic-kit:client-open-stream client nil)))
        (cl-quic-kit:stream-receive-data next 0 (receive-credit-octets 42))
        (check (equalp (cl-quic-kit:client-read-stream client next)
                       (receive-credit-octets 42))
               "another stream can receive after sixteen discarded final sizes"))))
  (multiple-value-bind (client flush) (receive-credit-fixture)
    (let* ((stream (cl-quic-kit:client-open-stream client nil))
           (flow (cl-quic-kit::quic-client-flow-control client))
           (initial (cl-quic-kit:flow-control-connection-receive-limit flow)))
      (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 1 2))
      (check (equalp (cl-quic-kit:client-read-stream client stream)
                     (receive-credit-octets 1 2))
             "reset control delivers and credits the earlier read")
      (funcall flush)
      (cl-quic-kit:stream-receive-data stream 4 (receive-credit-octets 5 6))
      (receive-credit-reset client stream 10 0)
      (check (= (cl-quic-kit:flow-control-connection-received flow) 10)
             "reset accounts for gaps and final size beyond buffered bytes")
      (check (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                (+ initial 10))
             "reset excludes previously replenished read bytes")
      (let ((frames (funcall flush)))
        (check (and (= (length frames) 1)
                    (eq (cl-quic-kit:frame-type (first frames)) :max-data)
                    (= (cl-quic-kit:frame-field (first frames) :maximum)
                       (+ initial 10)))
               "partial-read reset advertises only remaining connection credit"))
      (check (handler-case (progn (receive-credit-reset client stream 11 1) nil)
               (cl-quic-kit:flow-control-error () t))
             "conflicting reset final size still fails")
      (check (and (= (cl-quic-kit:flow-control-connection-received flow) 10)
                  (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                     (+ initial 10))
                  (null (funcall flush)))
             "invalid reset does not change receive accounting or advertisements"))))

(defun test-client-stop-reset-receive-credit ()
  (dolist (case '((:control nil nil nil nil 3)
                 (:stop-discard nil t nil nil 3)
                 (:stop-before-receive nil t t nil 3)
                 (:stop-late-gap nil t nil t 10)
                 (:credited-read :client t nil t 12)
                 (:uncredited-read :stream t nil t 12)))
    (destructuring-bind (name read-mode stop-p stop-first-p late-p final-size) case
      (multiple-value-bind (client flush) (receive-credit-fixture)
        (let* ((stream (cl-quic-kit:client-open-stream client nil))
               (flow (cl-quic-kit::quic-client-flow-control client))
               (initial (cl-quic-kit:flow-control-connection-receive-limit flow))
               (credited (if (eq read-mode :client) 2 0))
               (end (if read-mode 5 3)))
          (when read-mode
            (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 1 2))
            (check (equalp (if (eq read-mode :client)
                              (cl-quic-kit:client-read-stream client stream)
                              (cl-quic-kit:stream-read stream))
                           (receive-credit-octets 1 2))
                   (format nil "~A: earlier read delivers two bytes" name))
            (let ((frames (funcall flush)))
              (check (if (eq read-mode :client)
                         (and (= (length frames) 2)
                              (find :max-stream-data frames :key #'cl-quic-kit:frame-type)
                              (let ((frame (find :max-data frames
                                                 :key #'cl-quic-kit:frame-type)))
                                (and frame (= (cl-quic-kit:frame-field frame :maximum)
                                              (+ initial 2)))))
                         (null frames))
                     (format nil "~A: only client reads return connection credit" name))))
          (when stop-first-p (cl-quic-kit:stream-stop-sending stream 0))
          (cl-quic-kit:stream-receive-data
           stream (if read-mode 2 0) (receive-credit-octets 3 4 5))
          (check (= (cl-quic-kit:stream-readable-bytes stream)
                    (if stop-first-p 0 3))
                 (format nil "~A: STOP suppresses subsequent buffering" name))
          (check (= (cl-quic-kit:flow-control-connection-received flow) end)
                 (format nil "~A: received bytes remain charged" name))
          (when stop-p
            (cl-quic-kit:stream-stop-sending stream 0)
            (let ((offset (cl-quic-kit:stream-read-offset stream)))
              (cl-quic-kit:stream-stop-sending stream 0)
              (check (= (cl-quic-kit:stream-read-offset stream) offset)
                     (format nil "~A: duplicate STOP preserves read position" name)))
            (check (zerop (cl-quic-kit:stream-readable-bytes stream))
                   (format nil "~A: STOP discards buffered bytes" name)))
          (when late-p
            (cl-quic-kit:stream-receive-data
             stream (+ end 2) (receive-credit-octets 8 9))
            (check (= (cl-quic-kit:flow-control-connection-received flow) (+ end 4))
                   (format nil "~A: post-STOP gaps and data are charged" name))
            (check (zerop (cl-quic-kit:stream-readable-bytes stream))
                   (format nil "~A: post-STOP data is not buffered" name))
            (cl-quic-kit:stream-stop-sending stream 0))
          (check (and (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                         (+ initial credited))
                      (null (funcall flush)))
                 (format nil "~A: STOP itself does not return credit" name))
          (receive-credit-reset client stream final-size 0)
          (check (= (cl-quic-kit:flow-control-connection-received flow) final-size)
                 (format nil "~A: RESET charges its complete final size" name))
          (check (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                    (+ initial final-size))
                 (format nil "~A: RESET returns all previously uncredited bytes" name))
          (let ((frames (funcall flush)))
            (check (and (= (length frames) 1)
                        (eq (cl-quic-kit:frame-type (first frames)) :max-data)
                        (= (cl-quic-kit:frame-field (first frames) :maximum)
                           (+ initial final-size)))
                   (format nil "~A: RESET advertises connection credit only" name)))
          (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
            (check (and fin (zerop (length data)))
                   (format nil "~A: reset read is empty and terminal" name)))
          (receive-credit-reset client stream final-size 1)
          (cl-quic-kit:stream-stop-sending stream 0)
          (check (and (= (cl-quic-kit:flow-control-connection-received flow) final-size)
                      (= (cl-quic-kit:flow-control-connection-receive-limit flow)
                         (+ initial final-size))
                      (null (funcall flush)))
                 (format nil "~A: duplicate RESET and STOP do not return credit twice" name)))))))

(defun test-client-read-stream-ownership ()
  (multiple-value-bind (owner owner-flush) (receive-credit-fixture)
    (multiple-value-bind (other other-flush) (receive-credit-fixture)
      (let* ((stream (cl-quic-kit:client-open-stream owner nil))
             (other-stream (cl-quic-kit:client-open-stream other nil))
             (owner-flow (cl-quic-kit::quic-client-flow-control owner))
             (other-flow (cl-quic-kit::quic-client-flow-control other))
             (owner-limit (cl-quic-kit:flow-control-connection-receive-limit owner-flow))
             (other-limit (cl-quic-kit:flow-control-connection-receive-limit other-flow))
             (stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
        (check (= (cl-quic-kit:stream-id stream)
                  (cl-quic-kit:stream-id other-stream))
               "ownership control uses colliding registered stream IDs")
        (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 1 2 3))
        (check (handler-case (progn (cl-quic-kit:client-read-stream other stream) nil)
                 (cl-quic-kit:quic-error () t))
               "foreign stream read rejects by object identity")
        (check (and (zerop (cl-quic-kit::stream-read-offset stream))
                    (equalp (cl-quic-kit::stream-read-buffer stream)
                            (receive-credit-octets 1 2 3))
                    (= stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
               "foreign read rejects before consuming or changing the stream")
        (check (and (= owner-limit
                       (cl-quic-kit:flow-control-connection-receive-limit owner-flow))
                    (= other-limit
                       (cl-quic-kit:flow-control-connection-receive-limit other-flow))
                    (null (funcall owner-flush)) (null (funcall other-flush)))
               "foreign read changes neither client's credit or frame queue")
        (check (equalp (cl-quic-kit:client-read-stream owner stream)
                       (receive-credit-octets 1 2 3))
               "owning client can still consume the original bytes")
        (check (= (length (funcall owner-flush)) 2)
               "valid read still advertises stream and connection credit")
        (check (and (zerop (length (cl-quic-kit:client-read-stream other other-stream)))
                    (null (funcall other-flush)))
               "other client's registered stream remains a valid empty read")))))

(defun test-client-closed-read-credit ()
  (dolist (state '(:closing :draining :closed))
    (multiple-value-bind (client flush) (receive-credit-fixture)
      (let* ((stream (cl-quic-kit:client-open-stream client nil))
             (flow (cl-quic-kit::quic-client-flow-control client))
             (limit (cl-quic-kit:flow-control-connection-receive-limit flow))
             (stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
        (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 7 8) :fin t)
        (cl-quic-kit:connection-set-state (cl-quic-kit::quic-client-connection client)
                                          state)
        (multiple-value-bind (data fin) (cl-quic-kit:client-read-stream client stream)
          (check (and fin (equalp data (receive-credit-octets 7 8)))
                 (format nil "~A buffered read still delivers data and FIN" state)))
        (check (null (funcall flush))
               (format nil "~A buffered read does not advertise credit" state))
        (check (and (= limit (cl-quic-kit:flow-control-connection-receive-limit flow))
                    (= stream-limit (cl-quic-kit::stream-receive-max-offset stream)))
               (format nil "~A buffered read preserves advertised limits" state))
        (let ((discarded (cl-quic-kit:client-open-stream client nil)))
          (receive-credit-reset client discarded 4 0)
          (check (and (= (cl-quic-kit:flow-control-connection-received flow) 6)
                      (= limit (cl-quic-kit:flow-control-connection-receive-limit flow))
                      (null (funcall flush)))
                 (format nil "~A reset charges final size without advertising credit"
                         state))))))
  (multiple-value-bind (client flush) (receive-credit-fixture)
    (let ((stream (cl-quic-kit:client-open-stream client nil)))
      (cl-quic-kit:stream-receive-data stream 0 (receive-credit-octets 9 10))
      (cl-quic-kit:client-close client)
      (let ((packets (funcall flush :raw-p t))
            (peer (cl-quic-kit:make-quic-client
                   :local-connection-id (receive-credit-octets 0 0 0 0 0 0 0 0)
                   :destination-connection-id (receive-credit-octets 0 0 0 0 0 0 0 0)
                   :disable-hostname-verification-p t)))
        (check (= (length packets) 1) "client-close still transmits one packet")
        (cl-quic-kit::%client-set-key
         peer :initial :read (cl-quic-kit::%client-key client :initial :write))
        (multiple-value-bind (level number header)
            (cl-quic-kit::%client-unprotect-packet
             peer (first packets) (cl-quic-kit::%client-layout (first packets)))
          (declare (ignore number))
          (let ((frames (remove :padding
                                (cl-quic-kit:decode-frames
                                 (cl-quic-kit:packet-header-payload header))
                                :key #'cl-quic-kit:frame-type)))
            (check (and (eq level :initial) (= (length frames) 1)
                        (eq (cl-quic-kit:frame-type (first frames)) :connection-close))
                   "client-close still transmits its protected close frame"))))
      (check (equalp (cl-quic-kit:client-read-stream client stream)
                     (receive-credit-octets 9 10))
             "locally closed client retains buffered read access")
      (check (null (funcall flush))
             "locally closed buffered read queues no credit"))))

