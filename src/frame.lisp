(in-package #:cl-quic-kit)

(defstruct (frame (:constructor %make-frame (type fields))) type fields)
(defun make-frame (type &rest fields) (%make-frame type fields))
(defun frame-field (frame key &optional default) (getf (frame-fields frame) key default))

(defparameter *frame-type-codes*
  '((:padding . 0) (:ping . 1) (:ack . 2) (:ack-ecn . 3) (:reset-stream . 4)
    (:stop-sending . 5) (:crypto . 6) (:new-token . 7) (:max-data . 16)
    (:max-stream-data . 17) (:max-streams-bidi . 18) (:max-streams-uni . 19)
    (:data-blocked . 20) (:stream-data-blocked . 21) (:streams-blocked-bidi . 22)
    (:streams-blocked-uni . 23) (:new-connection-id . 24) (:retire-connection-id . 25)
    (:path-challenge . 26) (:path-response . 27) (:connection-close . 28)
    (:application-close . 29) (:handshake-done . 30) (:datagram . 49)))

(defun %frame-code (type)
  (cond ((and (integerp type) (<= 0 type) (< type (ash 1 62))) type)
        ((cdr (assoc type *frame-type-codes*))) ((eq type :stream) #x08)
        (t (error 'quic-encoding-error :message "Unknown QUIC frame type"))))
(defun %code-frame (code) (or (car (rassoc code *frame-type-codes*))
                              (if (<= #x08 code #x0f) :stream code)))
(defun %frame-octets (&rest parts)
  (let* ((parts (mapcar #'ensure-octets parts))
         (out (make-array (reduce #'+ parts :key #'length :initial-value 0)
                          :element-type '(unsigned-byte 8))) (at 0))
    (dolist (part parts out) (replace out part :start1 at) (incf at (length part)))))
(defun %v* (&rest values) (apply #'%frame-octets (mapcar #'encode-varint values)))
(defun %read-v (bytes at) (multiple-value-bind (v n) (decode-varint bytes at)
                             (values v (+ at n))))
(defun %slice (bytes at size)
  (when (or (< at 0) (< size 0) (> (+ at size) (length bytes)))
    (error 'quic-encoding-error :message "Truncated frame"))
  (values (subseq bytes at (+ at size)) (+ at size)))
(defun %field-octets (fields key &optional size)
  (let ((value (ensure-octets (getf fields key #()))))
    (when (and size (/= size (length value)))
      (error 'quic-encoding-error :message "Invalid fixed-size frame field")) value))

(defun encode-frame (frame)
  (let* ((type (frame-type frame)) (fields (frame-fields frame)) (code (%frame-code type)))
    (when (eq type :stream)
      (setf code (+ 8 (if (getf fields :fin) 1 0) (if (getf fields :len-present t) 2 0)
                  (if (getf fields :offset) 4 0))))
    (case type
      (:padding (make-array (max 1 (getf fields :count 1)) :element-type '(unsigned-byte 8)
                            :initial-element 0))
      ((:ping :handshake-done) (encode-varint code))
      ((:ack :ack-ecn)
       (let* ((ranges (or (getf fields :ranges)
                          (list (cons (getf fields :largest-acknowledged 0)
                                      (getf fields :first-range 0))))))
         (let ((out (%v* code (car (car ranges)) (getf fields :ack-delay 0)
                       (1- (length ranges)) (cdr (car ranges)))))
           (dolist (range (cdr ranges))
             (setf out (%frame-octets out (encode-varint (getf range :gap))
                                (encode-varint (getf range :range-length)))))
           (if (eq type :ack-ecn)
               (%frame-octets out (%v* (getf fields :ect0 0) (getf fields :ect1 0)
                                  (getf fields :ecn-ce 0))) out))))
      (:reset-stream (%v* code (getf fields :stream-id 0)
                           (getf fields :application-protocol-error-code 0)
                           (getf fields :final-size 0)))
      (:stop-sending (%v* code (getf fields :stream-id 0)
                           (getf fields :application-protocol-error-code 0)))
      (:crypto (let ((data (%field-octets fields :data)))
                 (%frame-octets (%v* code (getf fields :offset 0) (length data)) data)))
      (:new-token (let ((data (%field-octets fields :token)))
                    (%frame-octets (%v* code (length data)) data)))
      (:stream (let ((data (%field-octets fields :data)))
                 (%frame-octets (%v* code (getf fields :stream-id 0))
                          (if (getf fields :offset) (encode-varint (getf fields :offset)) #())
                          (if (getf fields :len-present t) (encode-varint (length data)) #()) data)))
      ((:max-data :max-streams-bidi :max-streams-uni :data-blocked
        :streams-blocked-bidi :streams-blocked-uni)
       (%v* code (or (getf fields :maximum) (getf fields :limit) 0)))
      ((:max-stream-data :stream-data-blocked)
       (%v* code (getf fields :stream-id 0) (or (getf fields :maximum) (getf fields :limit) 0)))
      (:new-connection-id
       (let ((cid (%field-octets fields :connection-id))
             (reset (%field-octets fields :stateless-reset-token 16)))
         (when (> (length cid) 20) (error 'quic-encoding-error :message "Connection ID is too long"))
         (%frame-octets (%v* code (getf fields :sequence 0) (getf fields :retire-prior-to 0))
                  (vector (length cid)) cid reset)))
      (:retire-connection-id (%v* code (getf fields :sequence 0)))
      ((:path-challenge :path-response) (%frame-octets (encode-varint code) (%field-octets fields :data 8)))
      ((:connection-close :application-close)
       (let ((reason (%field-octets fields :reason)))
         (%frame-octets (%v* code (getf fields :error-code 0)
                          (if (eq type :connection-close) (getf fields :frame-type 0) 0)
                          (length reason)) reason)))
      (:datagram (let ((data (%field-octets fields :data))) (%frame-octets (%v* code (length data)) data)))
      (otherwise (error 'quic-encoding-error :message "Frame encoding not implemented")))))

(defun decode-frame (bytes &optional (start 0))
  (let* ((b (ensure-octets bytes)) (at start))
    (multiple-value-bind (code next) (%read-v b at)
      (setf at next)
      (labels ((v () (multiple-value-bind (x n) (%read-v b at) (setf at n) x))
               (data (n) (multiple-value-bind (x n2) (%slice b at n) (setf at n2) x)))
        (let ((frame
                (cond
                  ((= code 0) (make-frame :padding :count 1)) ((= code 1) (make-frame :ping))
                  ((member code '(2 3))
                   (let* ((largest (v)) (delay (v)) (count (v)) (first (v))
                          (ranges (list (cons largest first))))
                     (dotimes (i count) (push (list :gap (v) :range-length (v)) ranges))
                     (setf ranges (nreverse ranges))
                     (if (= code 3)
                         (make-frame :ack-ecn :largest-acknowledged largest :ack-delay delay
                                     :ranges ranges :ect0 (v) :ect1 (v) :ecn-ce (v))
                         (make-frame :ack :largest-acknowledged largest :ack-delay delay :ranges ranges))))
                  ((= code 4) (make-frame :reset-stream :stream-id (v)
                                           :application-protocol-error-code (v) :final-size (v)))
                  ((= code 5) (make-frame :stop-sending :stream-id (v)
                                           :application-protocol-error-code (v)))
                  ((= code 6) (make-frame :crypto :offset (v) :data (data (v))))
                  ((= code 7) (make-frame :new-token :token (data (v))))
                  ((<= #x08 code #x0f) (make-frame :stream :stream-id (v)
                                      :offset (if (logbitp 2 code) (v) 0)
                                      :data (data (if (logbitp 1 code) (v) (- (length b) at)))
                                      :fin (logbitp 0 code) :len-present (logbitp 1 code)))
                  ((<= #x10 code #x17) (make-frame (%code-frame code) :maximum (v)))
                  ((= code #x18) (let ((sequence (v)) (retire (v)) (n (aref b at)))
                                   (incf at)
                                   (when (> n 20) (error 'quic-encoding-error :message "Connection ID is too long"))
                                   (make-frame :new-connection-id :sequence sequence :retire-prior-to retire
                                               :connection-id (data n) :stateless-reset-token (data 16))))
                  ((= code #x19) (make-frame :retire-connection-id :sequence (v)))
                  ((member code '(#x1a #x1b)) (make-frame (%code-frame code) :data (data 8)))
                  ((member code '(#x1c #x1d)) (make-frame (%code-frame code) :error-code (v)
                                      :frame-type (if (= code #x1c) (v) 0) :reason (data (v))))
                  ((= code #x1e) (make-frame :handshake-done))
                  ((= code #x31) (make-frame :datagram :data (data (v))))
                  (t (error 'quic-encoding-error :message "Unknown or unsupported QUIC frame type")))))
          (values frame at))))))

(defun encode-frames (frames) (apply #'%frame-octets (mapcar #'encode-frame frames)))
(defun decode-frames (bytes &optional (start 0))
  (let ((b (ensure-octets bytes)) (at start) (out '()))
    (loop while (< at (length b)) do
      (multiple-value-bind (frame next) (decode-frame b at) (push frame out) (setf at next)))
    (nreverse out)))
